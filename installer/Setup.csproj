<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The installer targets .NET Framework 4.8, which is part of every Windows 10/11 install, so it runs
    on any PC without installing anything first. It carries the self-contained app as an embedded zip
    (built by build.ps1) and extracts it to %LOCALAPPDATA%\Programs\ScreenTime.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>ScreenTime-Setup</AssemblyName>
    <RootNamespace>ScreenTimeSetup</RootNamespace>
    <ApplicationIcon>..\ScreenTime\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Product>Screen Time</Product>
    <AssemblyTitle>Screen Time Setup</AssemblyTitle>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <PayloadZip Condition="'$(PayloadZip)' == ''">..\build\payload.zip</PayloadZip>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <EmbeddedResource Include="$(PayloadZip)" LogicalName="payload.zip" />
    <EmbeddedResource Include="..\ScreenTime\app.ico" LogicalName="app.ico" />
  </ItemGroup>

</Project>
